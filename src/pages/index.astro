---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SITE, CATEGORIES, TRUST_PILLARS, PROCESS_STEPS } from "../data/site";
import { getFeaturedProducts } from "../data/products";

const featuredProducts = getFeaturedProducts();
---

<Layout>
  <!-- ===== HERO — Full-width elegant ===== -->
  <section class="relative w-full overflow-hidden bg-gray-900">
    <div class="swiper hero-swiper h-[500px] sm:h-[600px] md:h-[680px]">
      <div class="swiper-wrapper">
        <div class="swiper-slide relative">
          <img
            src="https://images.pexels.com/photos/3997388/pexels-photo-3997388.jpeg?auto=compress&cs=tinysrgb&w=1920"
            alt="Beauty Tools Factory"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/20 flex items-end pb-16 sm:pb-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-2xl animate-fade-in">
                <span class="inline-block text-pink-300 text-sm font-semibold tracking-widest uppercase mb-3">Est. 2015 · Source Factory</span>
                <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white mb-4 leading-tight tracking-tight">
                  Premium Beauty Tools<br class="hidden sm:block" /> Direct from Factory
                </h1>
                <p class="text-white/70 text-base sm:text-lg max-w-xl mb-8 leading-relaxed">
                  Nail · Eyelash · PMU · Beauty Devices · Hair Care · Makeup Tools — one trusted factory, 1000+ products, shipping to 60+ countries.
                </p>
                <div class="flex flex-wrap gap-4">
                  <a href="/products" class="btn bg-white text-gray-900 hover:bg-gray-100 border-none rounded-full px-8 py-3 font-semibold shadow-xl hover:scale-105 transition-transform">
                    View All Products
                    <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
                  </a>
                  <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello`}
                     target="_blank" rel="noopener noreferrer"
                     class="btn bg-green-500 text-white border-none rounded-full px-8 py-3 font-semibold hover:bg-green-600 hover:scale-105 transition-transform">
                    <Icon name="lucide:message-circle" class="w-5 h-5" />
                    WhatsApp Inquiry
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide relative">
          <img
            src="https://images.pexels.com/photos/7754652/pexels-photo-7754652.jpeg?auto=compress&cs=tinysrgb&w=1920"
            alt="Eyelash Products"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/20 flex items-end pb-16 sm:pb-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-2xl">
                <span class="inline-block text-pink-300 text-sm font-semibold tracking-widest uppercase mb-3">New Collection</span>
                <h2 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white mb-4 leading-tight tracking-tight">
                  Trending Beauty<br class="hidden sm:block" /> Products 2026
                </h2>
                <p class="text-white/70 text-base sm:text-lg max-w-xl mb-8 leading-relaxed">
                  Stay ahead with our latest hot-selling items. From LED face masks to keratin hair treatments — we manufacture what the market demands.
                </p>
                <a href="/products" class="btn bg-white text-gray-900 hover:bg-gray-100 border-none rounded-full px-8 py-3 font-semibold shadow-xl hover:scale-105 transition-transform">
                  Explore New Arrivals
                  <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide relative">
          <img
            src="https://images.pexels.com/photos/5069610/pexels-photo-5069610.jpeg?auto=compress&cs=tinysrgb&w=1920"
            alt="OEM Manufacturing"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/20 flex items-end pb-16 sm:pb-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-2xl">
                <span class="inline-block text-pink-300 text-sm font-semibold tracking-widest uppercase mb-3">OEM / ODM Service</span>
                <h2 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white mb-4 leading-tight tracking-tight">
                  Your Brand,<br class="hidden sm:block" /> Our Quality
                </h2>
                <p class="text-white/70 text-base sm:text-lg max-w-xl mb-8 leading-relaxed">
                  Custom packaging, private labeling, and product customization. Launch your beauty brand with our manufacturing expertise.
                </p>
                <a href="/contact" class="btn bg-white text-gray-900 hover:bg-gray-100 border-none rounded-full px-8 py-3 font-semibold shadow-xl hover:scale-105 transition-transform">
                  Request Custom Quote
                  <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Nav -->
      <div class="hero-next text-white! w-12 h-12 hover:scale-110 transition-transform hidden sm:flex items-center justify-center bg-white/10 hover:bg-white/20 backdrop-blur rounded-full cursor-pointer absolute right-6 top-1/2 -translate-y-1/2 z-50">
        <Icon name="lucide:chevron-right" class="w-6 h-6" />
      </div>
      <div class="hero-prev text-white! w-12 h-12 hover:scale-110 transition-transform hidden sm:flex items-center justify-center bg-white/10 hover:bg-white/20 backdrop-blur rounded-full cursor-pointer absolute left-6 top-1/2 -translate-y-1/2 z-50">
        <Icon name="lucide:chevron-left" class="w-6 h-6" />
      </div>
      <div class="swiper-pagination !bottom-8"></div>
    </div>
  </section>

  <!-- ===== CATEGORIES — Elegant Grid ===== -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-pink-500 text-sm font-semibold tracking-widest uppercase">Shop by Category</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-3 mb-4 tracking-tight">6 Product Lines, 1000+ SKUs</h2>
        <p class="text-gray-500 max-w-xl mx-auto text-sm sm:text-base">Everything your beauty business needs — from one trusted factory supplier.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {CATEGORIES.map((cat) => (
          <a href={`/category/${cat.slug}`}
            class="group relative overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-500 h-80 sm:h-96">
            <img src={cat.image} alt={cat.name}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent flex flex-col justify-end p-6 sm:p-8">
              <h3 class="text-xl sm:text-2xl font-bold text-white mb-1">{cat.name}</h3>
              <p class="text-white/70 text-sm mb-4">{cat.description}</p>
              <span class="inline-flex items-center gap-1 text-pink-300 text-sm font-semibold group-hover:gap-2 transition-all">
                Browse Collection <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HOT PRODUCTS — Clean Grid ===== -->
  <section class="py-20 sm:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-12 gap-4">
        <div>
          <span class="text-pink-500 text-sm font-semibold tracking-widest uppercase">Hot Right Now</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-3 tracking-tight">Trending Products</h2>
        </div>
        <a href="/products" class="btn btn-outline border-gray-300 text-gray-700 hover:bg-gray-900 hover:text-white hover:border-gray-900 rounded-full btn-sm transition-all duration-300">
          View All Products <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {featuredProducts.slice(0, 8).map((product) => (
          <a href={`/product/${product.slug}`}
            class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100">
            <div class="relative aspect-[3/4] overflow-hidden bg-gray-100">
              <img src={product.images[0]} alt={product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy" />
              {product.badge && (
                <span class="absolute top-3 left-3 bg-pink-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide">{product.badge}</span>
              )}
              {product.discount && product.discount > 0 && (
                <span class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">-{product.discount}%</span>
              )}
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/40 to-transparent h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                <span class="text-white text-xs font-semibold">Quick View</span>
              </div>
            </div>
            <div class="p-3 sm:p-4">
              <h3 class="font-semibold text-gray-900 group-hover:text-pink-600 transition-colors text-xs sm:text-sm leading-snug line-clamp-2 mb-2">{product.name}</h3>
              <div class="flex items-baseline justify-between">
                <span class="text-base sm:text-lg font-bold text-pink-600">${product.price.toFixed(2)}</span>
                <span class="text-[10px] sm:text-xs text-gray-400">/ unit wholesale</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TRUST PILLARS — Icon Grid ===== -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-pink-500 text-sm font-semibold tracking-widest uppercase">Why Buyers Choose Us</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-3 mb-4 tracking-tight">The Factory Advantage</h2>
        <p class="text-gray-500 max-w-xl mx-auto text-sm sm:text-base">10+ years of manufacturing excellence. Trusted by beauty importers in 60+ countries.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {TRUST_PILLARS.map((pillar) => (
          <div class="group text-center p-6 sm:p-8 rounded-2xl hover:bg-gray-50 transition-colors duration-300">
            <div class="w-14 h-14 bg-pink-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:bg-pink-100 transition-colors">
              <Icon name={pillar.icon} class="w-7 h-7 text-pink-600" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-2">{pillar.title}</h3>
            <p class="text-gray-500 text-xs sm:text-sm leading-relaxed">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FACTORY PREVIEW — Split Layout ===== -->
  <section class="py-20 sm:py-28 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-pink-400 text-sm font-semibold tracking-widest uppercase">Our Facility</span>
          <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-6 tracking-tight">5000+ sqm Manufacturing Base in Zhejiang, China</h2>
          <p class="text-gray-400 leading-relaxed mb-8">
            Two production bases equipped with modern manufacturing lines, dedicated QC stations,
            and an in-house R&D team that tracks global beauty trends to develop new products monthly.
          </p>
          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="border border-gray-700 rounded-xl p-4 text-center">
              <div class="text-2xl sm:text-3xl font-bold text-pink-400">10+</div>
              <div class="text-gray-400 text-xs mt-1">Years Experience</div>
            </div>
            <div class="border border-gray-700 rounded-xl p-4 text-center">
              <div class="text-2xl sm:text-3xl font-bold text-pink-400">60+</div>
              <div class="text-gray-400 text-xs mt-1">Export Countries</div>
            </div>
            <div class="border border-gray-700 rounded-xl p-4 text-center">
              <div class="text-2xl sm:text-3xl font-bold text-pink-400">1000+</div>
              <div class="text-gray-400 text-xs mt-1">Product SKUs</div>
            </div>
            <div class="border border-gray-700 rounded-xl p-4 text-center">
              <div class="text-2xl sm:text-3xl font-bold text-pink-400">2</div>
              <div class="text-gray-400 text-xs mt-1">Factories</div>
            </div>
          </div>
          <a href="/factory" class="btn bg-pink-500 text-white border-none rounded-full px-8 py-3 font-semibold hover:bg-pink-600 transition-colors">
            Tour Our Factory <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <img src="https://images.pexels.com/photos/3997388/pexels-photo-3997388.jpeg?auto=compress&cs=tinysrgb&w=600"
            alt="Factory Floor" class="rounded-2xl w-full h-40 sm:h-52 object-cover" loading="lazy" />
          <img src="https://images.pexels.com/photos/5069610/pexels-photo-5069610.jpeg?auto=compress&cs=tinysrgb&w=600"
            alt="Production Line" class="rounded-2xl w-full h-40 sm:h-52 object-cover mt-6" loading="lazy" />
          <img src="https://images.pexels.com/photos/3738346/pexels-photo-3738346.jpeg?auto=compress&cs=tinysrgb&w=600"
            alt="QC Process" class="rounded-2xl w-full h-40 sm:h-52 object-cover" loading="lazy" />
          <img src="https://images.pexels.com/photos/4465124/pexels-photo-4465124.jpeg?auto=compress&cs=tinysrgb&w=600"
            alt="Warehouse" class="rounded-2xl w-full h-40 sm:h-52 object-cover mt-6" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW WE WORK — 6 Steps ===== -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-pink-500 text-sm font-semibold tracking-widest uppercase">From Inquiry to Delivery</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-3 mb-4 tracking-tight">How We Work</h2>
        <p class="text-gray-500 max-w-xl mx-auto text-sm sm:text-base">A transparent 6-step process for worry-free wholesale purchasing.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 lg:gap-4">
        {PROCESS_STEPS.map((step) => (
          <div class="text-center relative group">
            <div class="w-14 h-14 bg-pink-50 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-pink-100 transition-colors relative z-10">
              <Icon name={step.icon} class="w-6 h-6 text-pink-600" />
            </div>
            <div class="absolute top-7 left-[calc(50%+2rem)] w-[calc(100%-3rem)] h-0.5 bg-pink-100 hidden lg:block z-0"></div>
            <div class="font-bold text-gray-900 text-sm mb-1">{step.title}</div>
            <p class="text-gray-500 text-xs leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BUYER GUIDES — Split Cards ===== -->
  <section class="py-20 sm:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-gray-100 relative overflow-hidden group hover:shadow-md transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-[80px] -mr-4 -mt-4"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center mb-5">
              <Icon name="lucide:user-plus" class="w-7 h-7 text-blue-600" />
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">For New Buyers</h3>
            <p class="text-gray-500 text-sm mb-6 leading-relaxed max-w-md">
              First time importing beauty products? We'll guide you through every step — from sample selection to customs clearance. Low MOQ for trial orders available.
            </p>
            <ul class="space-y-2.5 text-sm text-gray-600 mb-8">
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> Free sample consultation</li>
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> Low MOQ trial orders</li>
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> Step-by-step ordering guide</li>
            </ul>
            <a href="/how-to-order" class="inline-flex items-center gap-1 text-blue-600 font-semibold text-sm hover:gap-2 transition-all">
              How to Order <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-gray-100 relative overflow-hidden group hover:shadow-md transition-shadow">
          <div class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-bl-[80px] -mr-4 -mt-4"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center mb-5">
              <Icon name="lucide:briefcase" class="w-7 h-7 text-purple-600" />
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">For Professional Importers</h3>
            <p class="text-gray-500 text-sm mb-6 leading-relaxed max-w-md">
              Already in the beauty business? Access VIP wholesale pricing, priority production, dedicated account management, and complete OEM/ODM services.
            </p>
            <ul class="space-y-2.5 text-sm text-gray-600 mb-8">
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> Dedicated account manager</li>
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> OEM/ODM customization</li>
              <li class="flex items-center gap-2"><Icon name="lucide:check" class="w-4 h-4 text-green-500 flex-shrink-0" /> Priority production scheduling</li>
            </ul>
            <a href="/contact" class="inline-flex items-center gap-1 text-purple-600 font-semibold text-sm hover:gap-2 transition-all">
              Get VIP Quote <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA BANNER ===== -->
  <section class="py-24 sm:py-32 bg-gray-900 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-pink-500 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-pink-400 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">Ready to Start Your Order?</h2>
      <p class="text-gray-400 text-lg mb-10 max-w-lg mx-auto">
        Contact us today for wholesale pricing, samples, or a customized quotation. Response within 24 hours.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn bg-white text-gray-900 hover:bg-gray-100 border-none rounded-full px-10 py-3.5 font-semibold shadow-xl hover:scale-105 transition-transform">
          <Icon name="lucide:send" class="w-5 h-5" /> Send Inquiry
        </a>
        <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello`}
           target="_blank" rel="noopener noreferrer"
           class="btn bg-green-500 text-white border-none rounded-full px-10 py-3.5 font-semibold hover:bg-green-600 hover:scale-105 transition-transform">
          <Icon name="lucide:message-circle" class="w-5 h-5" /> Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
  :root {
    --swiper-pagination-color: #ec4899;
    --swiper-pagination-bullet-inactive-color: #fff;
    --swiper-pagination-bullet-inactive-opacity: 0.4;
  }
  .swiper-pagination-bullet-active {
    width: 28px;
    border-radius: 6px;
    transition: width 0.3s ease;
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay, EffectFade } from "swiper/modules";

  const initHeroSwiper = () => {
    new Swiper(".hero-swiper", {
      modules: [Navigation, Pagination, Autoplay, EffectFade],
      loop: true,
      effect: "fade",
      autoplay: { delay: 6000, disableOnInteraction: false },
      pagination: { el: ".swiper-pagination", clickable: true },
      navigation: { nextEl: ".hero-next", prevEl: ".hero-prev" },
    });
  };
  initHeroSwiper();
  document.addEventListener("astro:after-swap", initHeroSwiper);
</script>
