---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SITE, CATEGORIES, TRUST_PILLARS, PROCESS_STEPS } from "../data/site";
import { getFeaturedProducts } from "../data/products";

const featuredProducts = getFeaturedProducts();
---

<Layout>
  <!-- Hero Swiper -->
  <section id="hero-scroll-target" class="hero-scroll-target relative bg-gray-900 overflow-hidden">
    <div class="swiper hero-swiper w-full h-[70vh] sm:h-[85vh] min-h-[600px]">
      <div class="swiper-wrapper">
        <div class="swiper-slide relative">
          <img src="/images/placeholders/product.svg"
            alt="Beauty Tools Factory" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-black/50"></div>
          <div class="relative z-10 h-full flex items-center justify-center">
            <div class="text-center px-4 max-w-3xl" data-parallax="0.3">
              <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase leading-tight mb-4">
                Professional <span class="text-pink-400">Beauty Tools</span> Source Factory
              </h1>
              <p class="text-white/80 text-lg md:text-xl mb-8">6 product lines · 1000+ SKUs · OEM/ODM · Wholesale B2B</p>
              <div class="flex flex-wrap justify-center gap-4">
                <a href="/products" class="btn btn-primary btn-lg rounded-full px-10 text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-transform">Explore Products</a>
                <a href="/contact" class="btn bg-white/10 border-2 border-white text-white btn-lg rounded-full px-10 text-lg hover:bg-white/20 transition-colors backdrop-blur-sm">Get a Quote</a>
              </div>
            </div>
          </div>
        </div>
        <div class="swiper-slide relative">
          <img src="/images/placeholders/product.svg"
            alt="Nail Supplies" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-black/50"></div>
          <div class="relative z-10 h-full flex items-center justify-center">
            <div class="text-center px-4 max-w-3xl" data-parallax="0.3">
              <h2 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase leading-tight mb-4">
                Nail <span class="text-pink-400">Supplies</span>
              </h2>
              <p class="text-white/80 text-lg md:text-xl mb-8">Gel Polish · Nail Tips · Files · UV Lamps · Nail Art</p>
              <a href="/category/nails" class="btn btn-primary btn-lg rounded-full px-10 text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-transform">Explore Nail Supplies</a>
            </div>
          </div>
        </div>
        <div class="swiper-slide relative">
          <img src="/images/placeholders/product.svg"
            alt="Eyelash Supplies" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-black/50"></div>
          <div class="relative z-10 h-full flex items-center justify-center">
            <div class="text-center px-4 max-w-3xl" data-parallax="0.3">
              <h2 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase leading-tight mb-4">
                Eyelash <span class="text-pink-400">Supplies</span>
              </h2>
              <p class="text-white/80 text-lg md:text-xl mb-8">Extensions · Adhesives · Tweezers · Trays · Training Heads</p>
              <a href="/category/eyelashes" class="btn btn-primary btn-lg rounded-full px-10 text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-transform">Explore Eyelash Supplies</a>
            </div>
          </div>
        </div>
        <div class="swiper-slide relative">
          <img src="/images/placeholders/product.svg"
            alt="Permanent Makeup" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-black/50"></div>
          <div class="relative z-10 h-full flex items-center justify-center">
            <div class="text-center px-4 max-w-3xl" data-parallax="0.3">
              <h2 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase leading-tight mb-4">
                Permanent <span class="text-pink-400">Makeup</span>
              </h2>
              <p class="text-white/80 text-lg md:text-xl mb-8">PMU Machines · Pigments · Needles · Microblading</p>
              <a href="/category/permanent-makeup" class="btn btn-primary btn-lg rounded-full px-10 text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-transform">Explore PMU Supplies</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-prev absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white/15 backdrop-blur rounded-full flex items-center justify-center cursor-pointer hover:bg-white/30 transition-colors border border-white/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18l-6-6l6-6"/></svg>
      </div>
      <div class="hero-next absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white/15 backdrop-blur rounded-full flex items-center justify-center cursor-pointer hover:bg-white/30 transition-colors border border-white/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18l6-6l-6-6"/></svg>
      </div>
      <div class="swiper-pagination !bottom-6"></div>
    </div>
  </section>

  <!-- Our Partners (placed right below hero, dopamine ripple section) -->
  <section id="partners-section" class="py-16 sm:py-20 glass-muted overflow-hidden dopamine-ripple">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-[1]">
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 partners-title" data-parallax="0.3">Our Partners</h2>
      <p class="text-gray-500 mb-12 partners-subtitle max-w-2xl mx-auto" data-parallax="0.2">Trusted by beauty brands and distributors worldwide</p>
      <div class="partners-track overflow-hidden py-4">
        <div class="partners-scroll flex items-center gap-12">
          {[...Array(2)].map(() => (
            <>
              <div class="text-2xl font-black text-gray-400 partner-logo">L'OREAL</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">ESTEE LAUDER</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">MAYBELLINE</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">NYX</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">SEPHORA</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">ULTA</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">SALLY</div>
              <div class="text-2xl font-black text-gray-400 partner-logo">WATSONS</div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Products & Categories — combined section -->
  <section class="py-16 sm:py-20 glass-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-14" data-parallax="0.4">
        <span class="text-pink-400 text-sm font-bold uppercase tracking-widest">Our Products</span>
        <h2 class="text-3xl md:text-5xl font-black text-white mt-2 mb-4">6 Product Lines, 1000+ SKUs</h2>
        <p class="text-gray-300 max-w-xl mx-auto">From nail art to hair care — one factory, one order, one shipment</p>
      </div>

      <!-- Category Pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {CATEGORIES.map((cat) => (
          <a href={`/category/${cat.slug}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium text-white/80 hover:text-pink-300 bg-white/10 hover:bg-white/20 shadow-sm hover:shadow-md transition-all duration-200 border border-white/10 hover:border-pink-400/40">
            <Icon name={cat.icon} class="w-4 h-4 text-pink-400" />
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Featured Products Carousel Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        {featuredProducts.map((product) => (
          <a href={`/product/${product.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <div class="relative h-52 overflow-hidden">
              <img src={product.images[0]} alt={product.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
              {product.badge && (
                <span class="absolute top-3 left-3 bg-gradient-to-r from-pink-500 to-pink-600 text-white text-[10px] font-bold uppercase px-3 py-1 rounded-full shadow-lg">{product.badge}</span>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-5">
              <div class="text-xs text-pink-500 font-medium mb-1">{product.category}</div>
              <h3 class="font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-pink-600 transition-colors">{product.name}</h3>
              <div class="flex items-center justify-between">
                <span class="text-pink-600 font-black text-lg">${product.price.toFixed(2)}<span class="text-gray-400 text-xs font-normal">/unit</span></span>
                <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">MOQ {product.moq}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/products" class="btn bg-pink-500 hover:bg-pink-600 text-white border-none rounded-full px-10 py-3 font-semibold shadow-lg hover:shadow-xl transition-all duration-200">
          View All Products <Icon name="lucide:arrow-right" class="w-4 h-4 ml-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why Work With Us — redesigned -->
  <section class="py-16 sm:py-20 glass-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14" data-parallax="0.4">
        <span class="text-pink-500 text-sm font-bold uppercase tracking-widest">Why Choose Us</span>
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mt-2 mb-4">Why Work With Us</h2>
        <p class="text-gray-500 max-w-xl mx-auto">What sets us apart from other beauty tools suppliers</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {TRUST_PILLARS.map((pillar) => (
          <div class="group relative bg-white rounded-2xl pt-10 pb-8 px-6 text-center border border-gray-100 hover:border-pink-200 hover:shadow-xl transition-all duration-300" data-parallax="0.1">
            <!-- Floating icon above card -->
            <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-gradient-to-br from-pink-400 to-pink-600 rounded-2xl flex items-center justify-center shadow-lg shadow-pink-200 group-hover:shadow-pink-300 group-hover:scale-110 transition-all duration-300">
              <Icon name={pillar.icon} class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{pillar.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How to Order — redesigned with timeline -->
  <section class="py-16 sm:py-20 glass-muted">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14" data-parallax="0.4">
        <span class="text-pink-500 text-sm font-bold uppercase tracking-widest">Process</span>
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mt-2 mb-4">How to Order</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Four simple steps from factory to your door</p>
      </div>

      <div class="relative">
        <!-- Vertical connector line -->
        <div class="hidden md:block absolute left-[39px] top-8 bottom-8 w-0.5 bg-gradient-to-b from-pink-300 via-pink-400 to-pink-300"></div>

        <div class="space-y-6">
          {PROCESS_STEPS.map((step, i) => (
            <div class="flex gap-6 items-start">
              <!-- Step number circle -->
              <div class="relative z-10 flex-shrink-0 w-20 h-20 bg-gradient-to-br from-pink-400 to-pink-600 rounded-2xl flex items-center justify-center shadow-lg shadow-pink-200 text-white">
                <div class="text-center">
                  <div class="text-xs font-medium opacity-80">STEP</div>
                  <div class="text-2xl font-black leading-none">{i + 1}</div>
                </div>
              </div>
              <!-- Content card -->
              <div class="flex-1 bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-2">
                  <Icon name={step.icon} class="w-5 h-5 text-pink-500" />
                  <h3 class="font-bold text-gray-900 text-lg">{step.title}</h3>
                </div>
                <p class="text-gray-500 text-sm leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / Ready to Start -->
  <section class="relative py-20 sm:py-28 glass-dark-heavy text-center overflow-hidden">
    <div class="neon-glow-tr"></div>
    <div class="neon-glow-bl"></div>
    <div class="max-w-3xl mx-auto px-4 relative z-[1]">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-4" data-parallax="0.4">Ready to Start Your Order?</h2>
      <p class="text-gray-300 mb-8 text-lg" data-parallax="0.3">Contact our sales team today. We respond within 24 hours with pricing and product details.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-primary btn-lg rounded-full px-12 py-4 text-lg font-bold shadow-xl hover:shadow-2xl hover:scale-105 transition-transform">
          <Icon name="lucide:send" class="w-5 h-5" /> Send Inquiry
        </a>
        <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello`}
           target="_blank" rel="noopener noreferrer"
           class="btn bg-green-500 text-white border-none rounded-full px-10 py-3.5 font-semibold hover:bg-green-600 hover:scale-105 transition-transform">
          <Icon name="lucide:message-circle" class="w-5 h-5" /> Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>


  <!-- Page-specific styles -->
  <style>
  :root {
    --swiper-pagination-color: #ec4899;
    --swiper-pagination-bullet-inactive-color: #fff;
    --swiper-pagination-bullet-inactive-opacity: 0.3;
  }
  .swiper-pagination-bullet-active {
    width: 28px;
    border-radius: 6px;
    transition: width 0.3s ease;
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @keyframes partners-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .partners-scroll {
    animation: partners-scroll 30s linear infinite;
    width: max-content;
  }
  .partners-track:hover .partners-scroll {
    animation-play-state: paused;
  }
</style>

  <!-- Swiper JS -->
  <script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay, EffectFade } from "swiper/modules";

  const initHeroSwiper = () => {
    new Swiper(".hero-swiper", {
      modules: [Navigation, Pagination, Autoplay, EffectFade],
      loop: true,
      effect: "fade",
      fadeEffect: { crossFade: true },
      autoplay: { delay: 6000, disableOnInteraction: false },
      pagination: { el: ".swiper-pagination", clickable: true },
      navigation: { nextEl: ".hero-next", prevEl: ".hero-prev" },
    });
  };
  initHeroSwiper();
  document.addEventListener("astro:after-swap", initHeroSwiper);
</script>

  <!-- Parallax Scrolling -->
  <script is:inline>
  (function() {
    var ticking = false;
    function update() {
      var els = document.querySelectorAll("[data-parallax]");
      var wh = window.innerHeight;
      for (var i = 0; i < els.length; i++) {
        var el = els[i];
        var speed = parseFloat(el.dataset.parallax || "0.3");
        var rect = el.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < wh) {
          var center = rect.top + rect.height / 2;
          var offset = (center - wh / 2) * speed * -0.2;
          el.style.transform = "translateY(" + offset + "px)";
        }
      }
    }
    if (!window.__parallaxBound) {
      window.__parallaxBound = true;
      window.addEventListener("scroll", function() {
        if (!ticking) {
          requestAnimationFrame(function() { update(); ticking = false; });
          ticking = true;
        }
      }, { passive: true });
    }
    document.addEventListener("astro:after-swap", function() { update(); });
    update();
  })();
</script>

  <!-- Dopamine Ripple — properly destroys/re-inits on SPA navigation -->
  <script is:inline>
  (function() {
    var section, targetX, targetY, currentX, currentY, rafId;

    function onMove(e) {
      var rect = section.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width) * 100;
      targetY = ((e.clientY - rect.top) / rect.height) * 100;
    }

    function onLeave() {
      targetX = 50;
      targetY = 50;
    }

    function animate() {
      currentX += (targetX - currentX) * 0.07;
      currentY += (targetY - currentY) * 0.07;
      section.style.setProperty("--mx", currentX + "%");
      section.style.setProperty("--my", currentY + "%");
      rafId = requestAnimationFrame(animate);
    }

    function init() {
      section = document.getElementById("partners-section");
      if (!section) return;
      targetX = 50; targetY = 50;
      currentX = 50; currentY = 50;
      section.addEventListener("mousemove", onMove);
      section.addEventListener("mouseleave", onLeave);
      animate();
    }

    function destroy() {
      if (rafId) cancelAnimationFrame(rafId);
      if (section) {
        section.removeEventListener("mousemove", onMove);
        section.removeEventListener("mouseleave", onLeave);
        section = null;
      }
    }

    init();
    document.addEventListener("astro:after-swap", function() {
      destroy();
      setTimeout(init, 100);
    });
  })();
</script>
</Layout>
