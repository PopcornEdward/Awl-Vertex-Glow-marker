---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../data/site";

const pageData = await import("../data/pages/about.json").then(m => m.default).catch(() => null);
const t = (key: string, fallback: string) => (pageData && pageData[key]) || fallback;
const norm = (arr: any[], field: string): string[] =>
  (arr || []).map((item: any) => typeof item === "string" ? item : (item?.[field] || ""));
const defaults = {
  profile_images: ["https://images.pexels.com/photos/3997388/pexels-photo-3997388.jpeg?auto=compress&cs=tinysrgb&w=600", "https://images.pexels.com/photos/5069610/pexels-photo-5069610.jpeg?auto=compress&cs=tinysrgb&w=600", "https://images.pexels.com/photos/3738344/pexels-photo-3738344.jpeg?auto=compress&cs=tinysrgb&w=600", "https://images.pexels.com/photos/4465124/pexels-photo-4465124.jpeg?auto=compress&cs=tinysrgb&w=600"],
  regions: [{ name: "Africa", count: "25+ Countries", color: "pink" }, { name: "SE Asia", count: "10+ Countries", color: "blue" }, { name: "Middle East", count: "12+ Countries", color: "purple" }, { name: "Americas & EU", count: "15+ Countries", color: "green" }],
};
const profileImages = [1, 2, 3, 4].map(i => pageData?.[`profile_img_${i}`]).filter(Boolean);
if (profileImages.length === 0) profileImages.push(...defaults.profile_images);
const regions: Array<{ name: string; count: string; color: string }> = pageData?.regions || defaults.regions;
const colorMap: Record<string, string> = { pink: "bg-pink-50", blue: "bg-blue-50", purple: "bg-purple-50", green: "bg-green-50" };
const textColorMap: Record<string, string> = { pink: "text-pink-600", blue: "text-blue-600", purple: "text-purple-600", green: "text-green-600" };
---

<Layout>
  <!-- Hero -->
  <section class="relative h-56 sm:h-80 overflow-hidden">
    <img src={t("hero_image", "https://images.pexels.com/photos/3997388/pexels-photo-3997388.jpeg?auto=compress&cs=tinysrgb&w=1920")}
      alt={t("hero_title", "About Us")} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
      <div class="text-center px-4">
        <h1 class="text-3xl md:text-5xl font-black text-white uppercase">{t("hero_title", "About Us")}</h1>
        <p class="text-white/80 mt-2">{t("hero_subtitle", "Your trusted beauty tools source factory since 2015")}</p>
      </div>
    </div>
  </section>

  <!-- Company Profile -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-black text-gray-900 mb-6">{t("profile_title", "Company Profile")}</h2>
          <p class="text-gray-600 leading-relaxed mb-4">{t("profile_p1", "")}</p>
          <p class="text-gray-600 leading-relaxed mb-4">{t("profile_p2", "")}</p>
          <p class="text-gray-600 leading-relaxed">{t("profile_p3", "")}</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {profileImages.map((img: string, i: number) => (
            <img src={img} alt={`Factory ${i + 1}`} class="rounded-xl w-full h-48 object-cover" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Values -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="w-16 h-16 bg-pink-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <Icon name="lucide:target" class="w-8 h-8 text-pink-600" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{t("mission_title", "Our Mission")}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{t("mission_desc", "")}</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <Icon name="lucide:eye" class="w-8 h-8 text-blue-600" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{t("vision_title", "Our Vision")}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{t("vision_desc", "")}</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <Icon name="lucide:heart" class="w-8 h-8 text-green-600" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{t("values_title", "Our Values")}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{t("values_desc", "")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Reach -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black text-gray-900 mb-4">{t("global_title", "Global Reach")}</h2>
      <p class="text-gray-500 max-w-2xl mx-auto mb-8">{t("global_desc", "Our products reach 60+ countries across 4 continents.")}</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
        {regions.map((r: { name: string; count: string; color: string }) => (
          <div class={`${colorMap[r.color] || "bg-pink-50"} rounded-xl p-6`}>
            <div class={`text-2xl font-black ${textColorMap[r.color] || "text-pink-600"}`}>{r.name}</div>
            <div class="text-sm text-gray-500 mt-1">{r.count}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-900 text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-black uppercase mb-4">{t("cta_title", "Let's Work Together")}</h2>
      <p class="text-gray-300 mb-8">{t("cta_description", "Become our next long-term partner.")}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-primary btn-lg rounded-full px-10">Contact Us</a>
        <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello`}
           target="_blank" rel="noopener noreferrer"
           class="btn bg-green-500 border-green-500 text-white btn-lg rounded-full px-10 hover:bg-green-600">
          <Icon name="lucide:message-circle" class="w-5 h-5" /> WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
