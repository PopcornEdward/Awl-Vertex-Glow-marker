---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../data/site";
import FactoryPhotoWall from "../components/FactoryPhotoWall.astro";

const pageData = await import("../data/pages/factory.json").then(m => m.default).catch(() => null);
const t = (key: string, fallback: string) => (pageData && pageData[key]) || fallback;
const norm = (arr: any[], field: string): string[] =>
  (arr || []).map((item: any) => typeof item === "string" ? item : (item?.[field] || ""));
const defaults = {
  highlights: ["R&D Center: In-house product development team that tracks global beauty trends and creates new products monthly.", "Production Lines: 6 dedicated assembly lines with modern equipment for consistent quality at scale.", "QC Stations: 6-stage quality inspection integrated into every production batch.", "Warehouse: 2000+ sqm storage capacity for fast order fulfillment."],
  qc_stages: ["Material Inspection", "Production QC", "Function Test", "Appearance Check", "Packaging QC", "Final Audit"],
};
const highlights = norm(pageData?.highlights, "text").length ? norm(pageData.highlights, "text") : defaults.highlights;
const qcStages = norm(pageData?.qc_stages, "text").length ? norm(pageData.qc_stages, "text") : defaults.qc_stages;
const photoWallCategories = (pageData?.photo_wall_categories?.length
  ? pageData.photo_wall_categories.map((cat: any) => ({ name: cat.name || "", cover: cat.cover || "", images: norm(cat.images, "url") }))
  : [1, 2, 3, 4].map(i => ({ name: pageData?.[`pw_cat_${i}_name`] || "", cover: pageData?.[`pw_cat_${i}_cover`] || "", images: norm(pageData?.[`pw_cat_${i}_images`], "url") }))
).filter((c: any) => c.name && c.images.length > 0);
---

<Layout>
  <section class="relative h-48 sm:h-64 overflow-hidden">
    <img src={t("hero_image", "https://images.pexels.com/photos/3997388/pexels-photo-3997388.jpeg?auto=compress&cs=tinysrgb&w=1920")}
      alt={t("hero_title", "Factory Tour")} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
      <div class="text-center px-4">
        <h1 class="text-3xl md:text-5xl font-black text-white uppercase">{t("hero_title", "Factory Tour")}</h1>
        <p class="text-white/80 mt-2">{t("hero_subtitle", "See where your products are made")}</p>
      </div>
    </div>
  </section>

  <!-- Factory Highlights -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <div>
          <h2 class="text-3xl font-black text-gray-900 mb-6">{t("mfg_title", "Manufacturing Excellence")}</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            {t("mfg_description", "Our main factory is located in Zhejiang Province — the heart of China's manufacturing hub. Spanning 5,000+ sqm, our facility houses dedicated production lines for each product category: nail supplies, eyelash tools, PMU equipment, beauty devices, and daily chemical products.")}
          </p>
          <ul class="space-y-3 text-gray-600">
            {highlights.map((h: string) => (
              <li class="flex items-start gap-3">
                <Icon name="lucide:check-circle" class="w-5 h-5 text-green-500 mt-0.5 shrink-0" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
        <img src={t("mfg_image", "https://images.pexels.com/photos/5069610/pexels-photo-5069610.jpeg?auto=compress&cs=tinysrgb&w=800")}
          alt={t("mfg_title", "Factory Interior")} class="rounded-2xl w-full h-80 object-cover shadow-lg" />
      </div>

      <div class="text-center mb-10">
        <h2 class="text-2xl font-black text-gray-900 uppercase">{t("photo_wall_title", "Inside Our Factory")}</h2>
        <p class="text-gray-500 mt-2">{t("photo_wall_subtitle", "A transparent look at our production environment")}</p>
      </div>
      <FactoryPhotoWall categories={photoWallCategories.length > 0 ? photoWallCategories : undefined} />
    </div>
  </section>

  <!-- QC Process -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-black text-gray-900 text-center mb-12 uppercase">{t("qc_title", "6-Stage Quality Control")}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        {qcStages.map((stage: string, i: number) => (
          <div class="bg-white rounded-xl p-6 text-center shadow-sm">
            <div class="w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-3 text-pink-600 font-black">{i + 1}</div>
            <div class="font-semibold text-gray-900 text-sm">{stage}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-900 text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-black uppercase mb-4">{t("cta_title", "Want a Live Video Tour?")}</h2>
      <p class="text-gray-300 mb-8">{t("cta_description", "Contact us to schedule a live video walkthrough of our factory. We're proud to show you where your products come from.")}</p>
      <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello%2C%20I%20would%20like%20a%20factory%20video%20tour`}
         target="_blank" rel="noopener noreferrer"
         class="btn bg-green-500 border-green-500 text-white btn-lg rounded-full px-10 hover:bg-green-600">
        <Icon name="lucide:video" class="w-5 h-5" /> Request Video Tour
      </a>
    </div>
  </section>
</Layout>
