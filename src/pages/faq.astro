---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { FAQS, SITE } from "../data/site";
---

<Layout>
  <section class="relative h-48 sm:h-64 overflow-hidden">
    <img src="/images/placeholders/product.svg"
      alt="FAQ" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
      <div class="text-center px-4">
        <h1 class="text-3xl md:text-5xl font-black text-white uppercase">FAQ</h1>
        <p class="text-white/80 mt-2">Frequently asked questions</p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {FAQS.map((faq, i) => (
          <details class="group bg-gray-50 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-gray-900 hover:bg-gray-100 transition-colors list-none">
              <span class="flex items-center gap-3">
                <span class="w-6 h-6 bg-pink-100 rounded-full flex items-center justify-center text-xs font-black text-pink-600 shrink-0">{i + 1}</span>
                {faq.q}
              </span>
              <Icon name="lucide:chevron-down" class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0" />
            </summary>
            <div class="px-6 pb-6 text-gray-600 text-sm leading-relaxed border-t border-gray-200 pt-4 ml-12">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

      <!-- Can't find answer -->
      <div class="text-center mt-12 p-8 bg-pink-50 rounded-2xl">
        <h3 class="font-bold text-gray-900 text-lg mb-2">Can't find what you're looking for?</h3>
        <p class="text-gray-500 text-sm mb-4">Contact us directly and we'll answer your questions.</p>
        <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello%2C%20I%20have%20a%20question`}
           target="_blank" rel="noopener noreferrer"
           class="btn bg-green-500 border-green-500 text-white rounded-full btn-sm hover:bg-green-600">
          <Icon name="lucide:message-circle" class="w-4 h-4" /> Ask on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
