---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { CATEGORIES } from "../data/site";
---

<Layout>
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
        <a href="/" class="hover:text-pink-600 transition-colors">Home</a>
        <Icon name="lucide:chevron-right" class="w-3 h-3" />
        <a href="/products" class="text-gray-600 font-medium">All Products</a>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">All Products</h1>
      <p class="text-gray-500 text-sm mt-1">Browse our complete catalog of beauty tools and supplies</p>
    </div>
  </section>

  <section class="bg-white min-h-screen pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex gap-8 lg:gap-12">

        <!-- ===== SIDEBAR FILTERS ===== -->
        <aside id="filter-sidebar" class="hidden lg:block w-64 flex-shrink-0">
          <div class="sticky top-24 space-y-8">
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Search</h4>
              <div class="relative">
                <Icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                <input type="text" id="search-products" placeholder="Search products..."
                  class="input input-bordered input-sm w-full pl-9 text-sm rounded-lg focus:outline-none focus:border-pink-400" />
              </div>
            </div>
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Categories</h4>
              <div class="space-y-2">
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-category checkbox checkbox-sm checkbox-primary rounded" value="all" checked />
                  <span class="text-gray-700">All Categories</span>
                </label>
                {CATEGORIES.map((cat) => (
                  <label class="flex items-center gap-2 cursor-pointer text-sm">
                    <input type="checkbox" class="filter-category checkbox checkbox-sm checkbox-primary rounded" value={cat.slug} />
                    <span class="text-gray-700">{cat.name}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Price Range</h4>
              <div class="space-y-3">
                <input type="range" id="price-range" min="0" max="50" value="50" step="1" class="range range-xs range-primary" />
                <div class="flex justify-between text-xs text-gray-500">
                  <span>$0</span>
                  <span id="price-display">$50 max</span>
                </div>
              </div>
            </div>
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Product Type</h4>
              <div class="space-y-2">
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Hot Seller" />
                  <span class="text-gray-700">Hot Sellers</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Bestseller" />
                  <span class="text-gray-700">Bestsellers</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="New Arrival" />
                  <span class="text-gray-700">New Arrivals</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Premium" />
                  <span class="text-gray-700">Premium</span>
                </label>
              </div>
            </div>
            <button id="reset-filters" class="btn btn-outline btn-sm rounded-full w-full text-xs">
              <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" /> Reset Filters
            </button>
          </div>
        </aside>

        <!-- ===== MOBILE FILTER DRAWER ===== -->
        <div id="mobile-filter-overlay" class="hidden fixed inset-0 z-50 lg:hidden">
          <div class="absolute inset-0 bg-black/40" id="mobile-filter-backdrop"></div>
          <div class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl overflow-y-auto p-6">
            <div class="flex items-center justify-between mb-6">
              <h3 class="font-bold text-gray-900 text-lg">Filters</h3>
              <button id="close-mobile-filter" class="btn btn-ghost btn-circle btn-sm">
                <Icon name="lucide:x" class="w-5 h-5" />
              </button>
            </div>
            <div class="space-y-6">
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Search</h4>
                <div class="relative">
                  <Icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                  <input type="text" id="search-products-mobile" placeholder="Search products..."
                    class="input input-bordered input-sm w-full pl-9 text-sm rounded-lg focus:outline-none focus:border-pink-400" />
                </div>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Categories</h4>
                <div class="space-y-2">
                  <label class="flex items-center gap-2 cursor-pointer text-sm">
                    <input type="checkbox" class="filter-category-mobile checkbox checkbox-sm checkbox-primary rounded" value="all" checked />
                    <span class="text-gray-700">All Categories</span>
                  </label>
                  {CATEGORIES.map((cat) => (
                    <label class="flex items-center gap-2 cursor-pointer text-sm">
                      <input type="checkbox" class="filter-category-mobile checkbox checkbox-sm checkbox-primary rounded" value={cat.slug} />
                      <span class="text-gray-700">{cat.name}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Price Range</h4>
                <input type="range" id="price-range-mobile" min="0" max="50" value="50" step="1" class="range range-xs range-primary" />
                <div class="flex justify-between text-xs text-gray-500 mt-2">
                  <span>$0</span>
                  <span id="price-display-mobile">$50 max</span>
                </div>
              </div>
              <button id="reset-filters-mobile" class="btn btn-outline btn-sm rounded-full w-full text-xs">
                <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" /> Reset Filters
              </button>
            </div>
          </div>
        </div>

        <!-- ===== PRODUCTS AREA ===== -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-6 gap-4">
            <div class="flex items-center gap-4">
              <button id="open-mobile-filter" class="btn btn-outline btn-sm rounded-full lg:hidden text-xs">
                <Icon name="lucide:sliders-horizontal" class="w-4 h-4" /> Filters
              </button>
              <span id="product-count" class="text-sm text-gray-500">Loading...</span>
            </div>
            <select id="sort-select" class="select select-sm select-bordered rounded-full text-xs">
              <option value="default">Sort: Featured</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="name-asc">Name: A to Z</option>
              <option value="name-desc">Name: Z to A</option>
            </select>
          </div>

          <!-- Product Grid — populated client-side after fetch -->
          <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
            <!-- Skeleton placeholders shown while loading -->
          </div>

          <!-- Loader indicator -->
          <div id="load-more-trigger" class="text-center py-10"></div>
          <div id="loading-indicator" class="hidden text-center py-6">
            <span class="loading loading-spinner loading-md text-pink-500"></span>
          </div>

          <!-- Empty State -->
          <div id="no-results" class="hidden text-center py-20">
            <Icon name="lucide:search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4" />
            <p class="text-gray-400 font-semibold">No products match your filters</p>
            <p class="text-gray-400 text-sm mt-1">Try adjusting your search or filter criteria</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>


<script>
  var PAGE_SIZE = 12;
  var _allProducts = [];
  var _currentFiltered = [];
  var _renderedCount = 0;
  var _observer = null;
  var _loading = false;
  var _initDone = false;

  // ── Skeleton HTML ──
  function skeletonHTML() {
    var html = "";
    for (var i = 0; i < 6; i++) {
      html += '<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">' +
        '<div class="aspect-[3/4] bg-gray-200"></div>' +
        '<div class="p-3 sm:p-4 space-y-2">' +
        '<div class="h-3 bg-gray-200 rounded w-1/3"></div>' +
        '<div class="h-4 bg-gray-200 rounded w-3/4"></div>' +
        '<div class="h-5 bg-gray-200 rounded w-1/2"></div>' +
        '</div></div>';
    }
    return html;
  }

  // Show skeletons immediately
  var grid = document.getElementById("products-grid");
  if (grid) grid.innerHTML = skeletonHTML();

  // ── Card HTML from product data (short field names) ──
  function cardHTML(p) {
    var badgeHTML = p.b ? '<span class="absolute top-3 left-3 bg-pink-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide">' + p.b + '</span>' : '';
    var discountHTML = p.d > 0 ? '<span class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">-' + p.d + '%</span>' : '';
    return '<a href="/product/' + p.s + '"' +
      ' class="product-card group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100"' +
      ' data-category="' + p.c + '" data-price="' + p.p + '" data-badge="' + (p.b || '') + '" data-name="' + p.n.toLowerCase() + '">' +
      '<div class="relative aspect-[3/4] overflow-hidden bg-gray-100">' +
      '<img src="' + p.i + '" alt="' + p.n + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />' +
      badgeHTML + discountHTML +
      '<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/40 to-transparent h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3"><span class="text-white text-xs font-semibold">Quick View</span></div>' +
      '</div>' +
      '<div class="p-3 sm:p-4">' +
      '<span class="text-[10px] text-gray-400 uppercase tracking-wide">' + p.c.replace(/-/g, ' ') + '</span>' +
      '<h3 class="font-semibold text-gray-900 group-hover:text-pink-600 transition-colors text-xs sm:text-sm leading-snug line-clamp-2 mt-0.5 mb-2">' + p.n + '</h3>' +
      '<div class="flex items-baseline justify-between"><span class="text-base sm:text-lg font-bold text-pink-600">$' + p.p.toFixed(2) + '</span><span class="text-[10px] text-gray-400">wholesale</span></div>' +
      '</div></a>';
  }

  // ── Get active filters ──
  function getFilters() {
    var searchQ = (document.getElementById("search-products")?.value || "").toLowerCase();
    var searchQM = (document.getElementById("search-products-mobile")?.value || "").toLowerCase();
    var query = searchQ || searchQM;

    var catChecks = document.querySelectorAll(".filter-category:checked");
    var catChecksM = document.querySelectorAll(".filter-category-mobile:checked");
    var allCats = Array.from(catChecks).concat(Array.from(catChecksM)).map(function(c){return c.value});
    var specificCats = allCats.filter(function(c){return c !== "all"});
    var selectedCats = specificCats.length > 0 ? specificCats : ["all"];

    var maxPrice = parseInt(document.getElementById("price-range")?.value || "50");
    var maxPriceM = parseInt(document.getElementById("price-range-mobile")?.value || "50");
    maxPrice = Math.min(maxPrice, maxPriceM);

    var badgeChecks = document.querySelectorAll(".filter-badge:checked");
    var selectedBadges = Array.from(badgeChecks).map(function(c){return c.value});

    return { query: query, cats: selectedCats, maxPrice: maxPrice, badges: selectedBadges };
  }

  // ── Sort products ──
  function sortProducts(products, sortVal) {
    var sorted = products.slice();
    if (sortVal === "price-asc") sorted.sort(function(a,b){return a.p - b.p});
    else if (sortVal === "price-desc") sorted.sort(function(a,b){return b.p - a.p});
    else if (sortVal === "name-asc") sorted.sort(function(a,b){return a.n.localeCompare(b.n)});
    else if (sortVal === "name-desc") sorted.sort(function(a,b){return b.n.localeCompare(a.n)});
    return sorted;
  }

  // ── Filter + re-render (full reset, first page) ──
  function applyFilters() {
    if (!_initDone) return;
    var f = getFilters();
    var q = f.query;

    _currentFiltered = _allProducts.filter(function(p){
      if (q && p.n.toLowerCase().indexOf(q) === -1 && p.c.indexOf(q) === -1) return false;
      if (f.cats[0] !== "all" && f.cats.indexOf(p.c) === -1) return false;
      if (p.p > f.maxPrice) return false;
      if (f.badges.length > 0 && f.badges.indexOf(p.b) === -1) return false;
      return true;
    });

    var sortVal = document.getElementById("sort-select")?.value || "default";
    if (sortVal !== "default") _currentFiltered = sortProducts(_currentFiltered, sortVal);

    var grid = document.getElementById("products-grid");
    if (!grid) return;
    grid.innerHTML = "";
    _renderedCount = 0;
    renderNextPage();

    var countEl = document.getElementById("product-count");
    if (countEl) countEl.textContent = _currentFiltered.length + " products";
    var noResults = document.getElementById("no-results");
    if (noResults) noResults.classList.toggle("hidden", _currentFiltered.length > 0);
  }

  // ── Render next page of filtered products ──
  function renderNextPage() {
    var grid = document.getElementById("products-grid");
    if (!grid) return;
    var batch = _currentFiltered.slice(_renderedCount, _renderedCount + PAGE_SIZE);
    if (batch.length === 0) return;
    var html = "";
    for (var i = 0; i < batch.length; i++) { html += cardHTML(batch[i]); }
    grid.insertAdjacentHTML("beforeend", html);
    _renderedCount += batch.length;
    _loading = false;

    var indicator = document.getElementById("loading-indicator");
    if (indicator) indicator.classList.add("hidden");
  }

  // ── Load more (called by IntersectionObserver) ──
  function loadMore() {
    if (_loading) return;
    if (_renderedCount >= _currentFiltered.length) return;
    _loading = true;
    var indicator = document.getElementById("loading-indicator");
    if (indicator) indicator.classList.remove("hidden");
    setTimeout(function(){ renderNextPage(); }, 150);
  }

  // ── Infinite scroll observer ──
  function setupObserver() {
    if (_observer) _observer.disconnect();
    var trigger = document.getElementById("load-more-trigger");
    if (!trigger) return;
    _observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: "300px" });
    _observer.observe(trigger);
  }

  // ── Sort handler ──
  function bindSort() {
    document.getElementById("sort-select")?.addEventListener("change", applyFilters);
  }

  // ── Bind all filter inputs ──
  function bindFilterInputs() {
    document.getElementById("search-products")?.addEventListener("input", applyFilters);
    document.getElementById("search-products-mobile")?.addEventListener("input", applyFilters);
    document.querySelectorAll(".filter-badge").forEach(function(c){c.addEventListener("change", applyFilters)});

    function setupCategoryGroup(selector) {
      var all = document.querySelector(selector + '[value="all"]');
      var items = document.querySelectorAll(selector + ':not([value="all"])');
      if (!all || items.length === 0) return;
      items.forEach(function(item){
        item.addEventListener("change", function(){
          if (item.checked) all.checked = false;
          else { var any = Array.from(items).some(function(c){return c.checked}); if (!any) all.checked = true; }
          applyFilters();
        });
      });
      all.addEventListener("change", function(){
        if (all.checked) items.forEach(function(c){c.checked = false});
        applyFilters();
      });
    }
    setupCategoryGroup(".filter-category");
    setupCategoryGroup(".filter-category-mobile");

    document.getElementById("price-range")?.addEventListener("input", function(){
      document.getElementById("price-display").textContent = "$" + this.value + " max";
      applyFilters();
    });
    document.getElementById("price-range-mobile")?.addEventListener("input", function(){
      document.getElementById("price-display-mobile").textContent = "$" + this.value + " max";
      applyFilters();
    });

    function resetFilters() {
      document.querySelectorAll(".filter-category").forEach(function(c){c.checked = c.value === "all"});
      document.querySelectorAll(".filter-badge").forEach(function(c){c.checked = false});
      document.getElementById("price-range").value = "50";
      document.getElementById("price-display").textContent = "$50 max";
      document.getElementById("search-products").value = "";
      document.querySelectorAll(".filter-category-mobile").forEach(function(c){c.checked = c.value === "all"});
      document.getElementById("price-range-mobile").value = "50";
      document.getElementById("price-display-mobile").textContent = "$50 max";
      document.getElementById("search-products-mobile").value = "";
      applyFilters();
    }

    document.getElementById("reset-filters")?.addEventListener("click", resetFilters);
    document.getElementById("reset-filters-mobile")?.addEventListener("click", resetFilters);
  }

  // ── Mobile drawer ──
  function bindMobileDrawer() {
    document.getElementById("open-mobile-filter")?.addEventListener("click", function(){
      document.getElementById("mobile-filter-overlay")?.classList.remove("hidden");
    });
    document.getElementById("close-mobile-filter")?.addEventListener("click", function(){
      document.getElementById("mobile-filter-overlay")?.classList.add("hidden");
    });
    document.getElementById("mobile-filter-backdrop")?.addEventListener("click", function(){
      document.getElementById("mobile-filter-overlay")?.classList.add("hidden");
    });
  }

  // ── Fetch products & initialize ──
  function initProducts() {
    var base = document.querySelector("meta[name=\"base\"]")?.content || "/";
    fetch(base + "api/products-all.json")
      .then(function(r){ return r.json(); })
      .then(function(data){
        _allProducts = data;
        _currentFiltered = data.slice();
        _renderedCount = 0;
        _initDone = true;
        // Render first page
        if (grid) grid.innerHTML = "";
        renderNextPage();
        var countEl = document.getElementById("product-count");
        if (countEl) countEl.textContent = data.length + " products";
        setupObserver();
      })
      .catch(function(err){
        console.error("Failed to load products:", err);
        if (grid) grid.innerHTML = '<div class="col-span-full text-center py-20"><p class="text-red-400">Failed to load products. Please refresh.</p></div>';
      });
  }

  bindFilterInputs();
  bindSort();
  bindMobileDrawer();
  initProducts();

  document.addEventListener("astro:after-swap", function(){
    _initDone = false;
    _allProducts = [];
    _currentFiltered = [];
    _renderedCount = 0;
    grid = document.getElementById("products-grid");
    if (grid) grid.innerHTML = skeletonHTML();
    bindFilterInputs();
    bindSort();
    bindMobileDrawer();
    initProducts();
  });
</script>
</Layout>
