---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { products } from "../data/products";
import { CATEGORIES } from "../data/site";

const allProducts = products;
const priceRange = { min: 0, max: 50 };
---

<Layout>
  <!-- Header -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
        <a href="/" class="hover:text-pink-600 transition-colors">Home</a>
        <Icon name="lucide:chevron-right" class="w-3 h-3" />
        <a href="/products" class="text-gray-600 font-medium">All Products</a>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">All Products</h1>
      <p class="text-gray-500 text-sm mt-1">Browse our complete catalog of beauty tools and supplies</p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="bg-white min-h-screen pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex gap-8 lg:gap-12">

        <!-- ===== SIDEBAR FILTERS ===== -->
        <aside id="filter-sidebar" class="hidden lg:block w-64 flex-shrink-0">
          <div class="sticky top-24 space-y-8">

            <!-- Search -->
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Search</h4>
              <div class="relative">
                <Icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                <input type="text" id="search-products" placeholder="Search products..."
                  class="input input-bordered input-sm w-full pl-9 text-sm rounded-lg focus:outline-none focus:border-pink-400" />
              </div>
            </div>

            <!-- Categories -->
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Categories</h4>
              <div class="space-y-2">
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-category checkbox checkbox-sm checkbox-primary rounded" value="all" checked />
                  <span class="text-gray-700">All Categories</span>
                </label>
                {CATEGORIES.map((cat) => (
                  <label class="flex items-center gap-2 cursor-pointer text-sm">
                    <input type="checkbox" class="filter-category checkbox checkbox-sm checkbox-primary rounded" value={cat.slug} />
                    <span class="text-gray-700">{cat.name}</span>
                    <span class="text-gray-400 text-xs ml-auto">{products.filter(p => p.category === cat.slug).length}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Price Range -->
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Price Range</h4>
              <div class="space-y-3">
                <input type="range" id="price-range" min="0" max="50" value="50" step="1"
                  class="range range-xs range-primary" />
                <div class="flex justify-between text-xs text-gray-500">
                  <span>$0</span>
                  <span id="price-display">$50 max</span>
                </div>
              </div>
            </div>

            <!-- Badge Filter -->
            <div>
              <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Product Type</h4>
              <div class="space-y-2">
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Hot Seller" />
                  <span class="text-gray-700">Hot Sellers</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Bestseller" />
                  <span class="text-gray-700">Bestsellers</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="New Arrival" />
                  <span class="text-gray-700">New Arrivals</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" class="filter-badge checkbox checkbox-sm checkbox-primary rounded" value="Premium" />
                  <span class="text-gray-700">Premium</span>
                </label>
              </div>
            </div>

            <!-- Reset -->
            <button id="reset-filters" class="btn btn-outline btn-sm rounded-full w-full text-xs">
              <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" /> Reset Filters
            </button>
          </div>
        </aside>

        <!-- ===== MOBILE FILTER DRAWER ===== -->
        <div id="mobile-filter-overlay" class="hidden fixed inset-0 z-50 lg:hidden">
          <div class="absolute inset-0 bg-black/40" id="mobile-filter-backdrop"></div>
          <div class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl overflow-y-auto p-6">
            <div class="flex items-center justify-between mb-6">
              <h3 class="font-bold text-gray-900 text-lg">Filters</h3>
              <button id="close-mobile-filter" class="btn btn-ghost btn-circle btn-sm">
                <Icon name="lucide:x" class="w-5 h-5" />
              </button>
            </div>
            <div class="space-y-6">
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Search</h4>
                <div class="relative">
                  <Icon name="lucide:search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                  <input type="text" id="search-products-mobile" placeholder="Search products..."
                    class="input input-bordered input-sm w-full pl-9 text-sm rounded-lg focus:outline-none focus:border-pink-400" />
                </div>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Categories</h4>
                <div class="space-y-2">
                  <label class="flex items-center gap-2 cursor-pointer text-sm">
                    <input type="checkbox" class="filter-category-mobile checkbox checkbox-sm checkbox-primary rounded" value="all" checked />
                    <span class="text-gray-700">All Categories</span>
                  </label>
                  {CATEGORIES.map((cat) => (
                    <label class="flex items-center gap-2 cursor-pointer text-sm">
                      <input type="checkbox" class="filter-category-mobile checkbox checkbox-sm checkbox-primary rounded" value={cat.slug} />
                      <span class="text-gray-700">{cat.name}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div>
                <h4 class="font-bold text-gray-900 text-sm mb-3 uppercase tracking-wider">Price Range</h4>
                <input type="range" id="price-range-mobile" min="0" max="50" value="50" step="1" class="range range-xs range-primary" />
                <div class="flex justify-between text-xs text-gray-500 mt-2">
                  <span>$0</span>
                  <span id="price-display-mobile">$50 max</span>
                </div>
              </div>
              <button id="reset-filters-mobile" class="btn btn-outline btn-sm rounded-full w-full text-xs">
                <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" /> Reset Filters
              </button>
            </div>
          </div>
        </div>

        <!-- ===== PRODUCTS AREA ===== -->
        <div class="flex-1 min-w-0">
          <!-- Top Bar: Sort + Count + Mobile Filter Button -->
          <div class="flex items-center justify-between mb-6 gap-4">
            <div class="flex items-center gap-4">
              <button id="open-mobile-filter" class="btn btn-outline btn-sm rounded-full lg:hidden text-xs">
                <Icon name="lucide:sliders-horizontal" class="w-4 h-4" /> Filters
              </button>
              <span id="product-count" class="text-sm text-gray-500">{allProducts.length} products</span>
            </div>
            <select id="sort-select" class="select select-sm select-bordered rounded-full text-xs">
              <option value="default">Sort: Featured</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="name-asc">Name: A to Z</option>
              <option value="name-desc">Name: Z to A</option>
            </select>
          </div>

          <!-- Product Grid -->
          <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
            {allProducts.map((product) => (
              <a href={`/product/${product.slug}`}
                class="product-card group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100"
                data-category={product.category}
                data-price={product.price}
                data-badge={product.badge || ""}
                data-name={product.name.toLowerCase()}>
                <div class="relative aspect-[3/4] overflow-hidden bg-gray-100">
                  <img src={product.images[0]} alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy" />
                  {product.badge && (
                    <span class="absolute top-3 left-3 bg-pink-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide">{product.badge}</span>
                  )}
                  {product.discount && product.discount > 0 && (
                    <span class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">-{product.discount}%</span>
                  )}
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/40 to-transparent h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-3">
                    <span class="text-white text-xs font-semibold">Quick View</span>
                  </div>
                </div>
                <div class="p-3 sm:p-4">
                  <span class="text-[10px] text-gray-400 uppercase tracking-wide">{product.category.replace(/-/g, ' ')}</span>
                  <h3 class="font-semibold text-gray-900 group-hover:text-pink-600 transition-colors text-xs sm:text-sm leading-snug line-clamp-2 mt-0.5 mb-2">{product.name}</h3>
                  <div class="flex items-baseline justify-between">
                    <span class="text-base sm:text-lg font-bold text-pink-600">${product.price.toFixed(2)}</span>
                    <span class="text-[10px] text-gray-400">wholesale</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Empty State -->
          <div id="no-results" class="hidden text-center py-20">
            <Icon name="lucide:search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4" />
            <p class="text-gray-400 font-semibold">No products match your filters</p>
            <p class="text-gray-400 text-sm mt-1">Try adjusting your search or filter criteria</p>
          </div>
        </div>
      </div>
    </div>
  </section>
<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // ── Client-side filtering ──
  function filterProducts() {
    const searchQ = (document.getElementById("search-products") as HTMLInputElement)?.value?.toLowerCase() || "";
    const searchQMobile = (document.getElementById("search-products-mobile") as HTMLInputElement)?.value?.toLowerCase() || "";
    const query = searchQ || searchQMobile;

    const desktopChecks = document.querySelectorAll<HTMLInputElement>(".filter-category:checked");
    const mobileChecks = document.querySelectorAll<HTMLInputElement>(".filter-category-mobile:checked");
    const rawCats = [...Array.from(desktopChecks), ...Array.from(mobileChecks)].map(c => c.value);
    // If any specific category is selected, strip "all" from the set
    const specificCats = rawCats.filter(c => c !== "all");
    const selectedCats = specificCats.length > 0 ? specificCats : ["all"];

    const priceLimit = parseInt((document.getElementById("price-range") as HTMLInputElement)?.value || "50");
    const priceLimitMobile = parseInt((document.getElementById("price-range-mobile") as HTMLInputElement)?.value || "50");
    const maxPrice = Math.min(priceLimit, priceLimitMobile);

    const badgeChecks = document.querySelectorAll<HTMLInputElement>(".filter-badge:checked");
    const selectedBadges = Array.from(badgeChecks).map(c => c.value);

    const cards = document.querySelectorAll<HTMLElement>(".product-card");
    let visible = 0;

    cards.forEach((card) => {
      const cat = card.dataset.category || "";
      const price = parseFloat(card.dataset.price || "0");
      const badge = card.dataset.badge || "";
      const name = card.dataset.name || "";

      const matchSearch = !query || name.includes(query) || cat.includes(query);
      const matchCat = selectedCats.includes("all") || selectedCats.includes(cat);
      const matchPrice = price <= maxPrice;
      const matchBadge = selectedBadges.length === 0 || selectedBadges.includes(badge);

      if (matchSearch && matchCat && matchPrice && matchBadge) {
        card.style.display = "";
        visible++;
      } else {
        card.style.display = "none";
      }
    });

    const countEl = document.getElementById("product-count");
    if (countEl) countEl.textContent = `${visible} products`;

    const noResults = document.getElementById("no-results");
    if (noResults) noResults.classList.toggle("hidden", visible > 0);
  }

  function resetFilters() {
    document.querySelectorAll<HTMLInputElement>(".filter-category").forEach(c => { c.checked = c.value === "all"; });
    document.querySelectorAll<HTMLInputElement>(".filter-badge").forEach(c => { c.checked = false; });
    const priceEl = document.getElementById("price-range") as HTMLInputElement;
    if (priceEl) { priceEl.value = "50"; }
    const priceDisplay = document.getElementById("price-display");
    if (priceDisplay) priceDisplay.textContent = "$50 max";
    const searchEl = document.getElementById("search-products") as HTMLInputElement;
    if (searchEl) searchEl.value = "";

    document.querySelectorAll<HTMLInputElement>(".filter-category-mobile").forEach(c => { c.checked = c.value === "all"; });
    const priceMobile = document.getElementById("price-range-mobile") as HTMLInputElement;
    if (priceMobile) { priceMobile.value = "50"; }
    const priceDisplayMobile = document.getElementById("price-display-mobile");
    if (priceDisplayMobile) priceDisplayMobile.textContent = "$50 max";
    const searchMobile = document.getElementById("search-products-mobile") as HTMLInputElement;
    if (searchMobile) searchMobile.value = "";

    filterProducts();
  }

  function bindSort() {
    document.getElementById("sort-select")?.addEventListener("change", () => {
      const val = (document.getElementById("sort-select") as HTMLSelectElement).value;
      const grid = document.getElementById("products-grid");
      if (!grid) return;
      const cards = [...grid.querySelectorAll<HTMLElement>(".product-card")];

      cards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.price || "0");
        const priceB = parseFloat(b.dataset.price || "0");
        const nameA = a.dataset.name || "";
        const nameB = b.dataset.name || "";

        if (val === "price-asc") return priceA - priceB;
        if (val === "price-desc") return priceB - priceA;
        if (val === "name-asc") return nameA.localeCompare(nameB);
        if (val === "name-desc") return nameB.localeCompare(nameA);
        return 0;
      });

      cards.forEach(c => grid.appendChild(c));
    });
  }

  function bindFilters() {
    // Search inputs
    document.getElementById("search-products")?.addEventListener("input", filterProducts);
    document.getElementById("search-products-mobile")?.addEventListener("input", filterProducts);

    // Badge checkboxes
    document.querySelectorAll(".filter-badge").forEach(c => c.addEventListener("change", filterProducts));

    // Category mutual exclusion: selecting a category unchecks "All", unchecking everything rechecks "All"
    function setupCategoryGroup(selector: string) {
      const all = document.querySelector(selector + '[value="all"]') as HTMLInputElement;
      const items = document.querySelectorAll(selector + ':not([value="all"])') as NodeListOf<HTMLInputElement>;
      if (!all || items.length === 0) return;

      items.forEach(item => {
        item.addEventListener("change", () => {
          if (item.checked) {
            all.checked = false;
          } else {
            const anyChecked = Array.from(items).some(c => c.checked);
            if (!anyChecked) all.checked = true;
          }
          filterProducts();
        });
      });

      all.addEventListener("change", () => {
        if (all.checked) {
          items.forEach(c => { c.checked = false; });
        }
        filterProducts();
      });
    }
    setupCategoryGroup(".filter-category");
    setupCategoryGroup(".filter-category-mobile");

    // Price range
    document.getElementById("price-range")?.addEventListener("input", function() {
      const display = document.getElementById("price-display");
      if (display) display.textContent = `$${(this as HTMLInputElement).value} max`;
      filterProducts();
    });
    document.getElementById("price-range-mobile")?.addEventListener("input", function() {
      const display = document.getElementById("price-display-mobile");
      if (display) display.textContent = `$${(this as HTMLInputElement).value} max`;
      filterProducts();
    });

    // Reset
    document.getElementById("reset-filters")?.addEventListener("click", resetFilters);
    document.getElementById("reset-filters-mobile")?.addEventListener("click", resetFilters);

    // Mobile filter drawer
    document.getElementById("open-mobile-filter")?.addEventListener("click", () => {
      document.getElementById("mobile-filter-overlay")?.classList.remove("hidden");
    });
    document.getElementById("close-mobile-filter")?.addEventListener("click", () => {
      document.getElementById("mobile-filter-overlay")?.classList.add("hidden");
    });
    document.getElementById("mobile-filter-backdrop")?.addEventListener("click", () => {
      document.getElementById("mobile-filter-overlay")?.classList.add("hidden");
    });

    bindSort();
  }

  // ── Init + SPA re-init ──
  bindFilters();
  document.addEventListener("astro:after-swap", bindFilters);
</script>
</Layout>
