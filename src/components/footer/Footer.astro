---
import { Icon } from "astro-icon/components";
import { SITE } from "../../data/site";
---

<footer class="bg-gray-900 text-gray-300 pt-16 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-pink-500 rounded-xl flex items-center justify-center">
            <Icon name="lucide:sparkles" class="w-6 h-6 text-white" />
          </div>
          <span class="text-xl font-bold text-white">{SITE.name}</span>
        </a>
        <p class="text-gray-400 mb-6 leading-relaxed text-sm">
          China source factory for nail, eyelash, PMU, beauty tools & daily chemical products.
          Wholesale B2B supplier — direct factory pricing, global shipping.
        </p>
        <div class="flex gap-3">
          <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}`}
             target="_blank" rel="noopener noreferrer"
             class="btn btn-circle btn-sm bg-green-600 border-none text-white hover:bg-green-700">
            <Icon name="lucide:message-circle" class="w-4 h-4" />
          </a>
          <a href={`mailto:${SITE.email}`}
             class="btn btn-circle btn-sm bg-gray-700 border-none text-white hover:bg-gray-600">
            <Icon name="lucide:mail" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="font-bold text-white text-lg mb-4">Products</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/category/nails" class="text-gray-400 hover:text-pink-400 transition-colors">Nail Supplies</a></li>
          <li><a href="/category/eyelashes" class="text-gray-400 hover:text-pink-400 transition-colors">Eyelash Supplies</a></li>
          <li><a href="/category/permanent-makeup" class="text-gray-400 hover:text-pink-400 transition-colors">Permanent Makeup</a></li>
          <li><a href="/category/beauty-tools" class="text-gray-400 hover:text-pink-400 transition-colors">Beauty Tools</a></li>
          <li><a href="/category/daily-chemical" class="text-gray-400 hover:text-pink-400 transition-colors">Daily Chemical</a></li>
          <li><a href="/category/makeup-tools" class="text-gray-400 hover:text-pink-400 transition-colors">Makeup Tools</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-bold text-white text-lg mb-4">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/about" class="text-gray-400 hover:text-pink-400 transition-colors">About Us</a></li>
          <li><a href="/factory" class="text-gray-400 hover:text-pink-400 transition-colors">Factory Tour</a></li>
          <li><a href="/how-to-order" class="text-gray-400 hover:text-pink-400 transition-colors">How to Order</a></li>
          <li><a href="/after-sales" class="text-gray-400 hover:text-pink-400 transition-colors">After-Sales Service</a></li>
          <li><a href="/faq" class="text-gray-400 hover:text-pink-400 transition-colors">FAQ</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-pink-400 transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-bold text-white text-lg mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-2">
            <Icon name="lucide:map-pin" class="w-4 h-4 mt-0.5 shrink-0 text-pink-400" />
            <span>{SITE.address}</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:phone" class="w-4 h-4 shrink-0 text-pink-400" />
            <span>{SITE.phone}</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:mail" class="w-4 h-4 shrink-0 text-pink-400" />
            <span>{SITE.email}</span>
          </li>
        </ul>
        <!-- Newsletter -->
        <div class="mt-6">
          <p class="text-sm text-gray-400 mb-3">Subscribe for product trends & wholesale quotes</p>
          <div class="flex gap-0">
            <input type="email" placeholder="Your email"
              class="input input-sm input-bordered rounded-r-none w-full bg-gray-800 border-gray-700 text-white text-sm" />
            <button class="btn btn-sm btn-primary rounded-l-none px-3">
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 flex flex-col md:flex-row justify-between items-center gap-3 text-sm text-gray-500">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="#" class="hover:text-gray-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-gray-300 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-gray-300 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
