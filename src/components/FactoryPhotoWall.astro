---
import { Icon } from "astro-icon/components";

const pexels = (id: number) =>
  `https://images.pexels.com/photos/${id}/pexels-photo-${id}.jpeg?auto=compress&cs=tinysrgb`;

const defaultCategories = [
  {
    name: "Raw Materials",
    cover: pexels(27967281) + "&w=600",
    images: [27967281, 37598393, 36397980, 17315564, 36878025, 33791802, 36397790, 27967288, 17315568].map(id => pexels(id) + "&w=1200"),
  },
  {
    name: "Production Line",
    cover: pexels(34221997) + "&w=600",
    images: [34221997, 36423822, 34718930, 18631424, 5532716, 29988964, 31212954, 38357014, 31112181].map(id => pexels(id) + "&w=1200"),
  },
  {
    name: "Quality Control",
    cover: pexels(37466061) + "&w=600",
    images: [37466061, 35383621, 31336017, 34054482, 5953835, 35383622, 31090818, 31112229, 32845674].map(id => pexels(id) + "&w=1200"),
  },
  {
    name: "Packing & Loading",
    cover: pexels(15016523) + "&w=600",
    images: [15016523, 11903465, 4483775, 5329064, 31112245, 4483774, 11678431, 31251587, 31112188].map(id => pexels(id) + "&w=1200"),
  },
];

interface Cat { name: string; cover: string; images: string[]; }
const { categories: rawCategories } = Astro.props as { categories?: Cat[] };

const categories: Cat[] = (rawCategories && rawCategories.length > 0)
  ? rawCategories
  : defaultCategories;

const catJson = JSON.stringify(categories);
const firstImages = [categories[0].cover, ...categories[0].images];
---

<div class="factory-gallery space-y-6">
  <!-- Category Tabs -->
  <div id="factory-cat-tabs" class="flex gap-2 py-3 overflow-x-auto no-scrollbar">
    {categories.map((cat, i) => (
      <button
        data-cat={i}
        onclick="switchFactoryCat(this)"
        class={`factory-cat-tab flex-shrink-0 px-5 py-2.5 rounded-full text-sm font-semibold transition-colors whitespace-nowrap
          ${i === 0 ? "bg-pink-500 text-white" : "text-gray-600 hover:bg-gray-100 bg-gray-50"}`}
      >
        {cat.name}
      </button>
    ))}
  </div>

  <!-- Main Swiper -->
  <div class="relative">
    <div class="swiper factory-main-swiper aspect-[16/10] md:aspect-[21/9] rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
      <div class="swiper-wrapper">
        {firstImages.map((img, i) => (
          <div class="swiper-slide">
            <img src={img} alt={`${categories[0].name} ${i + 1}`} class="w-full h-full object-cover" />
          </div>
        ))}
      </div>
    </div>
    <div class="factory-swiper-prev absolute left-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/80 backdrop-blur rounded-full flex items-center justify-center cursor-pointer shadow-md hover:bg-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18l-6-6l6-6"/></svg>
    </div>
    <div class="factory-swiper-next absolute right-3 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white/80 backdrop-blur rounded-full flex items-center justify-center cursor-pointer shadow-md hover:bg-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18l6-6l-6-6"/></svg>
    </div>
  </div>

  <!-- Thumbnails -->
  {firstImages.length > 1 && (
    <div class="swiper factory-thumb-swiper !h-20">
      <div class="swiper-wrapper">
        {firstImages.map((img, i) => (
          <div class="swiper-slide !w-20 rounded-xl overflow-hidden cursor-pointer opacity-50 transition-opacity">
            <img src={img} alt="" class="w-full h-full object-cover" />
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<div id="factory-photo-data" hidden>{catJson}</div>

<script>
  import Swiper from "swiper";
  import { Navigation, Thumbs } from "swiper/modules";

  var FACTORY_CATS = [];
  try {
    FACTORY_CATS = JSON.parse(document.getElementById("factory-photo-data").textContent || "[]");
  } catch(e) { FACTORY_CATS = []; }

  var factoryCurrentCat = 0;
  var factoryThumbSwiper = null;

  function factoryImages(catIdx) {
    var c = FACTORY_CATS[catIdx];
    return c ? [c.cover, ...c.images] : [];
  }

  window.switchFactoryCat = function(btn) {
    factoryCurrentCat = parseInt(btn.getAttribute("data-cat"));
    document.querySelectorAll(".factory-cat-tab").forEach(function(b) {
      var active = parseInt(b.getAttribute("data-cat")) === factoryCurrentCat;
      b.classList.toggle("bg-pink-500", active);
      b.classList.toggle("text-white", active);
      b.classList.toggle("text-gray-600", !active);
      b.classList.toggle("hover:bg-gray-100", !active);
      b.classList.toggle("bg-gray-50", !active);
    });
    buildFactorySlides();
    initFactorySwiper();
  };

  function buildFactorySlides() {
    var images = factoryImages(factoryCurrentCat);
    var cat = FACTORY_CATS[factoryCurrentCat];
    var mainW = document.querySelector(".factory-main-swiper .swiper-wrapper");
    var thumbW = document.querySelector(".factory-thumb-swiper .swiper-wrapper");
    if (!mainW) return;

    var mainH = "", thumbH = "";
    for (var i = 0; i < images.length; i++) {
      mainH += '<div class="swiper-slide"><img src="' + images[i] + '" alt="' + cat.name + ' ' + (i+1) + '" class="w-full h-full object-cover" /></div>';
      thumbH += '<div class="swiper-slide !w-20 rounded-xl overflow-hidden cursor-pointer opacity-50 transition-opacity"><img src="' + images[i] + '" alt="" class="w-full h-full object-cover" /></div>';
    }
    mainW.innerHTML = mainH;
    if (thumbW) thumbW.innerHTML = thumbH;
  }

  function initFactorySwiper() {
    var mainEl = document.querySelector(".factory-main-swiper");
    var thumbEl = document.querySelector(".factory-thumb-swiper");
    if (!mainEl) return;

    if (mainEl.swiper) mainEl.swiper.destroy(true, true);
    if (thumbEl && thumbEl.swiper) thumbEl.swiper.destroy(true, true);

    if (thumbEl) {
      factoryThumbSwiper = new Swiper(thumbEl, {
        modules: [Navigation],
        spaceBetween: 8,
        slidesPerView: "auto",
        watchSlidesProgress: true,
      });
      new Swiper(mainEl, {
        modules: [Navigation, Thumbs],
        navigation: { prevEl: ".factory-swiper-prev", nextEl: ".factory-swiper-next" },
        thumbs: { swiper: factoryThumbSwiper },
        loop: false,
      });
    } else {
      new Swiper(mainEl, {
        modules: [Navigation],
        navigation: { prevEl: ".factory-swiper-prev", nextEl: ".factory-swiper-next" },
        loop: false,
      });
    }
  }

  initFactorySwiper();
  document.addEventListener("astro:after-swap", function() {
    try { FACTORY_CATS = JSON.parse(document.getElementById("factory-photo-data").textContent || "[]"); } catch(e) { FACTORY_CATS = []; }
    factoryCurrentCat = 0;
    document.querySelectorAll(".factory-cat-tab").forEach(function(b) {
      var active = b.getAttribute("data-cat") === "0";
      b.classList.toggle("bg-pink-500", active);
      b.classList.toggle("text-white", active);
      b.classList.toggle("text-gray-600", !active);
      b.classList.toggle("hover:bg-gray-100", !active);
      b.classList.toggle("bg-gray-50", !active);
    });
    buildFactorySlides();
    setTimeout(initFactorySwiper, 50);
  });
</script>

<style is:global>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .factory-main-swiper { position: relative; }
  .factory-thumb-swiper .swiper-slide-thumb-active { opacity: 1 !important; }
</style>
