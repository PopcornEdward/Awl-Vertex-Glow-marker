---
import { Icon } from "astro-icon/components";
import { SITE } from "../../data/site";
import { CATEGORIES } from "../../data/site";

const topCategories = CATEGORIES.filter(c => ["Nail Supplies", "Eyelash Supplies", "Permanent Makeup"].includes(c.name));
const moreCategories = CATEGORIES.filter(c => !["Nail Supplies", "Eyelash Supplies", "Permanent Makeup"].includes(c.name));
---

<div id="main-navbar" class="sticky top-0 z-999 w-full font-sans transition-transform duration-300">
  <nav class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Left: Logo -->
        <div class="flex items-center gap-8 flex-shrink-0">
          <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
            <div class="w-8 h-8 bg-pink-500 rounded-lg flex items-center justify-center group-hover:rotate-12 transition-transform flex-shrink-0">
              <Icon name="lucide:sparkles" class="w-4.5 h-4.5 text-white" />
            </div>
            <span class="text-base font-bold text-gray-900 tracking-tight hidden sm:block whitespace-nowrap">{SITE.name}</span>
            <span class="text-sm font-bold text-gray-900 sm:hidden">AVGM</span>
          </a>

          <!-- Desktop Nav Links -->
          <div class="hidden lg:flex items-center gap-1">
            <a href="/" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">Home</a>

            <!-- 美甲 -->
            <a href="/category/nails" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">Nail Supplies</a>

            <!-- 美睫 -->
            <a href="/category/eyelashes" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">Eyelash Supplies</a>

            <!-- 纹绣 -->
            <a href="/category/permanent-makeup" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">Permanent Makeup</a>

            <!-- More Categories Dropdown -->
            <div class="relative group">
              <button class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap flex items-center gap-1 cursor-pointer">
                More
                <Icon name="lucide:chevron-down" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
              </button>
              <div class="absolute top-full left-0 mt-1 w-56 bg-white rounded-xl shadow-xl border border-gray-100 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                {moreCategories.map((cat) => (
                  <a href={`/category/${cat.slug}`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-pink-50 hover:text-pink-600 transition-colors">
                    {cat.name}
                  </a>
                ))}
                <div class="border-t border-gray-100 my-1"></div>
                <a href="/products" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-pink-50 hover:text-pink-600 transition-colors font-medium">
                  All Products
                </a>
              </div>
            </div>

            <a href="/factory" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">Factory</a>
            <a href="/about" class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-pink-600 rounded-lg hover:bg-pink-50 transition-colors whitespace-nowrap">About</a>
          </div>
        </div>

        <!-- Right: Actions -->
        <div class="flex items-center gap-2 flex-shrink-0">
          <!-- Search -->
          <button id="search-toggle" class="btn btn-ghost btn-circle btn-sm hidden sm:flex" aria-label="Search">
            <Icon name="lucide:search" class="w-5 h-5 text-gray-600" />
          </button>

          <!-- WhatsApp -->
          <a href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello`}
             target="_blank" rel="noopener noreferrer"
             class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 hover:text-green-600 px-3 py-2 rounded-lg hover:bg-green-50 transition-colors">
            <Icon name="lucide:message-circle" class="w-4 h-4 text-green-500" />
            WhatsApp
          </a>

          <!-- Theme Toggle -->
          <button id="theme-toggle" class="btn btn-ghost btn-circle btn-sm" aria-label="Toggle theme">
            <Icon name="lucide:sun" class="w-5 h-5 hidden dark-icon" />
            <Icon name="lucide:moon" class="w-5 h-5 light-icon" />
          </button>

          <!-- Quote CTA -->
          <a href="/contact" class="btn btn-sm bg-pink-500 hover:bg-pink-600 text-white border-none rounded-full px-5 text-sm font-medium shadow-sm">
            Get Quote
          </a>

          <!-- Mobile Menu Toggle -->
          <button id="mobile-menu-btn" class="btn btn-ghost btn-circle btn-sm lg:hidden ml-1" aria-label="Menu">
            <Icon name="lucide:menu" class="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white shadow-lg">
      <div class="p-4 space-y-1">
        <a href="/" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Home</a>
        <a href="/category/nails" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Nail Supplies</a>
        <a href="/category/eyelashes" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Eyelash Supplies</a>
        <a href="/category/permanent-makeup" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Permanent Makeup</a>
        <details class="group">
          <summary class="py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium cursor-pointer list-none flex items-center justify-between">
            More Categories
            <Icon name="lucide:chevron-down" class="w-4 h-4 transition group-open:rotate-180" />
          </summary>
          <div class="ml-3 space-y-0.5">
            {moreCategories.map((cat) => (
              <a href={`/category/${cat.slug}`} class="block py-2 px-3 text-sm rounded hover:bg-pink-50 text-gray-600">{cat.name}</a>
            ))}
            <a href="/products" class="block py-2 px-3 text-sm rounded hover:bg-pink-50 font-medium text-pink-600">All Products →</a>
          </div>
        </details>
        <a href="/factory" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Factory Tour</a>
        <a href="/about" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">About Us</a>
        <a href="/contact" class="block py-2.5 px-3 rounded-lg hover:bg-pink-50 text-sm font-medium">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Search Overlay -->
  <div id="search-overlay" class="hidden fixed inset-0 z-1000 bg-black/40 backdrop-blur-sm flex items-start justify-center pt-24 px-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden">
      <div class="flex items-center border-b border-gray-100 px-5 py-3">
        <Icon name="lucide:search" class="w-5 h-5 text-gray-400 flex-shrink-0" />
        <input id="search-input" type="text" placeholder="Search products..."
          class="w-full px-3 py-2 text-base outline-none border-none bg-transparent" autofocus />
        <button id="search-close" class="btn btn-ghost btn-circle btn-sm flex-shrink-0">
          <Icon name="lucide:x" class="w-5 h-5" />
        </button>
      </div>
      <div id="search-results" class="max-h-80 overflow-y-auto p-3 space-y-1">
        <p class="text-gray-400 text-sm text-center py-10">Type to search products...</p>
      </div>
      <!-- Keyboard hints -->
      <div class="flex items-center justify-between px-5 py-2.5 border-t border-gray-100 text-[11px] text-gray-400 bg-gray-50/50">
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-200 text-[10px] font-mono">↑↓</kbd> Navigate</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-200 text-[10px] font-mono">↵</kbd> Open</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-200 text-[10px] font-mono">Esc</kbd> Close</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var THEME_KEY = "theme";
    var lastScrollY = 0;
    var systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    var initDone = false;
    var searchSelectedIdx = -1;
    var searchMatches = [];
    var allProducts = [];
    var tearDownFns = [];

    // ── Parse products once (the JSON is inline in <script type="application/json">) ──
    var productsEl = document.getElementById("products-data");
    try {
      allProducts = productsEl ? JSON.parse(productsEl.textContent || "[]") : [];
    } catch (e) {
      allProducts = [];
    }

    function timeBasedTheme() {
      var hour = new Date().getHours();
      return hour >= 6 && hour < 18 ? "light" : "dark";
    }

    function resolveTheme() {
      var saved = localStorage.getItem(THEME_KEY);
      if (saved === "dark" || saved === "light") return saved;
      if (systemDark.matches) return "dark";
      if (window.matchMedia("(prefers-color-scheme: light)").matches) return "light";
      return timeBasedTheme();
    }

    function handleScroll() {
      var navbar = document.getElementById("main-navbar");
      if (!navbar) return;
      var y = window.scrollY;
      if (y <= 0) { navbar.classList.remove("navbar-hidden"); lastScrollY = y; return; }
      if (y > lastScrollY) navbar.classList.add("navbar-hidden");
      else navbar.classList.remove("navbar-hidden");
      lastScrollY = y;
    }

    function initNavbar() {
      var html = document.documentElement;
      var fns = []; // cleanup functions registered this cycle

      // Mobile menu
      var menuBtn = document.getElementById("mobile-menu-btn");
      var menu = document.getElementById("mobile-menu");
      if (menuBtn && menu) {
        var toggleMenu = function () { menu.classList.toggle("hidden"); };
        menuBtn.addEventListener("click", toggleMenu);
        fns.push(function () { menuBtn.removeEventListener("click", toggleMenu); });
      }

      // Theme toggle
      var themeToggle = document.getElementById("theme-toggle");
      var sunIcon = document.querySelector(".dark-icon");
      var moonIcon = document.querySelector(".light-icon");

      function setTheme(theme, save) {
        html.setAttribute("data-theme", theme);
        if (save) localStorage.setItem(THEME_KEY, theme);
        if (theme === "dark") {
          if (sunIcon) sunIcon.classList.remove("hidden");
          if (moonIcon) moonIcon.classList.add("hidden");
        } else {
          if (sunIcon) sunIcon.classList.add("hidden");
          if (moonIcon) moonIcon.classList.remove("hidden");
        }
      }

      var current = html.getAttribute("data-theme");
      if (!current || current === "light" || current === "dark") {
        var resolved = resolveTheme();
        if (current !== resolved) setTheme(resolved);
      }

      if (themeToggle) {
        var toggleClick = function () {
          var cur = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
          setTheme(cur, true);
        };
        themeToggle.addEventListener("click", toggleClick);
        fns.push(function () { themeToggle.removeEventListener("click", toggleClick); });
      }

      // Search
      var searchToggle = document.getElementById("search-toggle");
      var searchOverlay = document.getElementById("search-overlay");
      var searchClose = document.getElementById("search-close");
      var searchInput = document.getElementById("search-input");
      var searchResults = document.getElementById("search-results");

      function openSearch() {
        if (searchOverlay) searchOverlay.classList.remove("hidden");
        searchSelectedIdx = -1;
        searchMatches = [];
        setTimeout(function () { if (searchInput) searchInput.focus(); }, 100);
      }

      function closeSearch() {
        if (searchOverlay) searchOverlay.classList.add("hidden");
        if (searchInput) searchInput.value = "";
        searchSelectedIdx = -1;
        searchMatches = [];
        if (searchResults) searchResults.innerHTML = '<p class="text-gray-400 text-sm text-center py-10">Type to search products...</p>';
      }

      function renderResults() {
        if (!searchResults) return;
        searchResults.innerHTML = searchMatches.map(function (p, i) {
          return '<a href="/product/' + p.slug + '" data-search-idx="' + i + '"' +
            ' class="search-result-item flex items-center gap-4 p-3 rounded-xl transition-colors ' +
            (i === searchSelectedIdx ? 'bg-pink-50 ring-1 ring-pink-200' : 'hover:bg-gray-50') + '">' +
            '<img src="' + p.images[0] + '" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />' +
            '<div class="min-w-0">' +
            '<div class="font-medium text-gray-900 text-sm truncate">' + p.name + '</div>' +
            '<div class="text-xs text-gray-500">' + p.category + ' · $' + p.price.toFixed(2) + '/unit</div>' +
            '</div></a>';
        }).join("");
      }

      function selectResult(idx) {
        if (!searchResults) return;
        var prev = searchResults.querySelector(".search-result-item.bg-pink-50");
        if (prev) { prev.classList.remove("bg-pink-50", "ring-1", "ring-pink-200"); prev.classList.add("hover:bg-gray-50"); }
        searchSelectedIdx = idx;
        var next = searchResults.querySelector('[data-search-idx="' + idx + '"]');
        if (next) { next.classList.add("bg-pink-50", "ring-1", "ring-pink-200"); next.classList.remove("hover:bg-gray-50"); next.scrollIntoView({ block: "nearest" }); }
      }

      function navigateResult(delta) {
        if (searchMatches.length === 0) return;
        var newIdx = searchSelectedIdx < 0
          ? (delta > 0 ? 0 : searchMatches.length - 1)
          : (searchSelectedIdx + delta + searchMatches.length) % searchMatches.length;
        selectResult(newIdx);
      }

      function openSelected() {
        if (searchSelectedIdx >= 0 && searchSelectedIdx < searchMatches.length) {
          window.location.href = "/product/" + searchMatches[searchSelectedIdx].slug;
        }
      }

      if (searchToggle) { searchToggle.addEventListener("click", openSearch); fns.push(function () { searchToggle.removeEventListener("click", openSearch); }); }
      if (searchClose) { searchClose.addEventListener("click", closeSearch); fns.push(function () { searchClose.removeEventListener("click", closeSearch); }); }
      if (searchOverlay) {
        var overlayClick = function (e) { if (e.target === searchOverlay) closeSearch(); };
        searchOverlay.addEventListener("click", overlayClick);
        fns.push(function () { searchOverlay.removeEventListener("click", overlayClick); });
      }

      if (searchInput) {
        var inputHandler = function () {
          if (!searchResults) return;
          var q = searchInput.value.toLowerCase().trim();
          if (!q) {
            searchMatches = [];
            searchSelectedIdx = -1;
            searchResults.innerHTML = '<p class="text-gray-400 text-sm text-center py-10">Type to search products...</p>';
            return;
          }
          var lowerQ = q;
          searchMatches = allProducts.filter(function (p) { return p.name.toLowerCase().indexOf(lowerQ) !== -1 || p.category.toLowerCase().indexOf(lowerQ) !== -1 || p.description.toLowerCase().indexOf(lowerQ) !== -1; });
          searchSelectedIdx = -1;
          if (searchMatches.length === 0) {
            searchResults.innerHTML = '<p class="text-gray-400 text-sm text-center py-10">No products found.</p>';
            return;
          }
          renderResults();
        };
        searchInput.addEventListener("input", inputHandler);
        fns.push(function () { searchInput.removeEventListener("input", inputHandler); });
      }

      var globalKeyHandler = function (e) {
        if (!searchOverlay || searchOverlay.classList.contains("hidden")) return;
        if (e.key === "Escape") { e.preventDefault(); closeSearch(); return; }
        if (e.key === "ArrowDown") { e.preventDefault(); navigateResult(1); return; }
        if (e.key === "ArrowUp") { e.preventDefault(); navigateResult(-1); return; }
        if (e.key === "Enter") { e.preventDefault(); openSelected(); return; }
      };
      document.addEventListener("keydown", globalKeyHandler);
      fns.push(function () { document.removeEventListener("keydown", globalKeyHandler); });

      // Store cleanup fns for next destroy cycle
      tearDownFns = fns;
    }

    function destroyNavbar() {
      for (var i = 0; i < tearDownFns.length; i++) {
        try { tearDownFns[i](); } catch (e) {}
      }
      tearDownFns = [];
    }

    // ── OS theme listener (register once globally) ──
    systemDark.addEventListener("change", function (e) {
      if (!localStorage.getItem(THEME_KEY)) {
        document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
      }
    });

    // ── Scroll listener (register once globally) ──
    window.addEventListener("scroll", handleScroll, { passive: true });

    // ── Bootstrap + SPA lifecycle ──
    initNavbar();
    document.addEventListener("astro:after-swap", function () {
      destroyNavbar();
      initNavbar();
    });
  })();
</script>

<style>
  .navbar-hidden { transform: translateY(-100%); }
  .w-4\.5 { width: 1.125rem; }
  .h-4\.5 { height: 1.125rem; }
</style>
