---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/navbar/NavBar.astro";
import Footer from "../components/footer/Footer.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import { SITE } from "../data/site";
---

<!doctype html>
<html lang="en" data-theme="light" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={SITE.description} />
    <meta property="og:title" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow" />
    <title>{SITE.name} — {SITE.tagline}</title>
    <ClientRouter />
    <!-- Inline theme detection — runs before paint to prevent FOIT -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
          return;
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
          return;
        }
        var hour = new Date().getHours();
        document.documentElement.setAttribute("data-theme", hour >= 6 && hour < 18 ? "light" : "dark");
      })();
    </script>
  </head>
  <body class="bg-white min-h-screen overflow-x-hidden relative">
    <!-- Vanta.js Starfield Background -->
    <div id="vanta-body-bg" class="fixed inset-0 z-0 pointer-events-none"></div>

    <!-- Content Layers -->
    <div class="relative z-10">
      <Navbar />
      <main class="overflow-x-hidden">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- WhatsApp -->
    <a
      href={`https://api.whatsapp.com/send?phone=${SITE.whatsapp}&text=Hello%20I%27m%20interested%20in%20your%20products`}
      target="_blank" rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform duration-200 hover:shadow-xl"
      aria-label="Chat on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    </a>

    <!-- Music Player -->
    <MusicPlayer />

    <!-- Scroll to Top -->
    <button
      id="scroll-to-top"
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
      class="fixed bottom-24 right-6 z-50 w-12 h-12 bg-pink-500 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-all duration-300 hover:shadow-xl"
      aria-label="Scroll to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15l-6-6l-6 6"/></svg>
    </button>

    <!-- Vanta.js Starfield Init (is:inline → re-executes per swap, no module caching) -->
    <script is:inline>
      window.__vantaInstance = window.__vantaInstance || null;

      window.__loadVanta = window.__loadVanta || function(src) {
        return new Promise(function(resolve, reject) {
          if (document.querySelector('script[src="' + src + '"]')) return resolve();
          var s = document.createElement("script");
          s.src = src;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      };

      window.__initStarfield = async function() {
        var el = document.getElementById("vanta-body-bg");
        if (!el) return;
        if (window.__vantaInstance) {
          try { window.__vantaInstance.destroy(); } catch(e) {}
          window.__vantaInstance = null;
        }
        try {
          await window.__loadVanta("https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js");
          await window.__loadVanta("https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js");
          window.__vantaInstance = window.VANTA.NET({
            el: "#vanta-body-bg",
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200,
            minWidth: 200,
            scale: 1,
            scaleMobile: 1,
            color: 0x8899cc,
            backgroundColor: 0x050510,
            points: 16,
            maxDistance: 24,
            spacing: 19,
            showDots: true,
          });
        } catch(e) {
          console.warn("Vanta starfield background unavailable");
        }
      };

      window.__initStarfield();

      if (!window.__vantaSwapBound) {
        window.__vantaSwapBound = true;
        document.addEventListener("astro:after-swap", function() {
          setTimeout(window.__initStarfield, 300);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    max-width: 100vw;
    overflow-x: hidden;
  }
</style>
